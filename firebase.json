{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "tests/**",
      "scripts/**",
      "README.md",
      "firestore.rules"
    ],
    "headers": [
      { "source": "**/*.@(html|js|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|css)", "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }] }
    ]
  }
}
